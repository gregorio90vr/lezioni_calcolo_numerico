\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Bond A: prezzo esatto vs approssimazioni di Taylor al 1\textsuperscript  {o} e 2\textsuperscript  {o} ordine. Per $\Delta y$ piccoli le tre curve sono indistinguibili; per $\Delta y$ grandi la sola duration (retta tangente) si allontana visibilmente dall'esatto, mentre la correzione di convexity la insegue.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:taylor-prezzo}{{3}{9}{Bond A: prezzo esatto vs approssimazioni di Taylor al 1\textsuperscript {o} e 2\textsuperscript {o} ordine. Per $\Delta y$ piccoli le tre curve sono indistinguibili; per $\Delta y$ grandi la sola duration (retta tangente) si allontana visibilmente dall'esatto, mentre la correzione di convexity la insegue}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Bond A: errore di troncamento (bps di prezzo) delle due approssimazioni. L'errore lineare cresce come $\Delta y^2$ (resta il termine di convexity trascurato), quello quadratico come $\Delta y^3$ --- una cifra di precisione in più per ogni raddoppio della finezza dello sviluppo.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:taylor-errore}{{4}{9}{Bond A: errore di troncamento (bps di prezzo) delle due approssimazioni. L'errore lineare cresce come $\Delta y^2$ (resta il termine di convexity trascurato), quello quadratico come $\Delta y^3$ --- una cifra di precisione in più per ogni raddoppio della finezza dello sviluppo}{figure.4}{}}
