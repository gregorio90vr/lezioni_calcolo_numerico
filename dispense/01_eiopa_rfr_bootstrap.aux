\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Curva ricostruita e confronto col benchmark}{18}{subsection.4.4}\protected@file@percent }
\newlabel{sec:ricostr-confronto}{{4.4}{18}{Curva ricostruita e confronto col benchmark}{subsection.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Curva EIOPA EUR ricostruita (bootstrap + FSP/LLFR), dicembre~2025: spot $z_t$ (blu) e forward $f_t$ (rosso), tenor $1$--$60$ --- la stessa curva gi\`a anticipata in Figura~\ref {fig:spot-fwd-media}. I punti neri sono gli spot ai tenor DLT osservati; la linea verticale \`e l'FSP (20 anni). Il forward ha il consueto andamento a gradini fino all'FSP (ipotesi di forward costante nei gap, Sez.~\ref {sec:nonlin}) e oltre converge all'$\mathrm  {UFR}= 3.30\%$ (l'avvicinamento prosegue, pi\`u lentamente, fino a 150 anni: si veda la Figura~\ref {fig:convufr}).}}{18}{figure.8}\protected@file@percent }
\newlabel{fig:ricostruzione}{{8}{18}{Curva EIOPA EUR ricostruita (bootstrap + FSP/LLFR), dicembre~2025: spot $z_t$ (blu) e forward $f_t$ (rosso), tenor $1$--$60$ --- la stessa curva gi\`a anticipata in Figura~\ref {fig:spot-fwd-media}. I punti neri sono gli spot ai tenor DLT osservati; la linea verticale \`e l'FSP (20 anni). Il forward ha il consueto andamento a gradini fino all'FSP (ipotesi di forward costante nei gap, Sez.~\ref {sec:nonlin}) e oltre converge all'$\UFR = 3.30\%$ (l'avvicinamento prosegue, pi\`u lentamente, fino a 150 anni: si veda la Figura~\ref {fig:convufr})}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Ricostruzione vs curva ufficiale EIOPA, dicembre~2025. \emph  {Sopra}: spot ricostruito (blu) e ufficiale (rosso, cerchi aperti), tenor $1$--$60$ (vista; le statistiche RMSE/max sono calcolate sull'intero orizzonte disponibile, 1--120). \emph  {Sotto}: scarti in bps; blu = zona liquida ($T\le \mathrm  {FSP}$), rosso = estrapolazione.}}{19}{figure.9}\protected@file@percent }
\newlabel{fig:vs-benchmark}{{9}{19}{Ricostruzione vs curva ufficiale EIOPA, dicembre~2025. \emph {Sopra}: spot ricostruito (blu) e ufficiale (rosso, cerchi aperti), tenor $1$--$60$ (vista; le statistiche RMSE/max sono calcolate sull'intero orizzonte disponibile, 1--120). \emph {Sotto}: scarti in bps; blu = zona liquida ($T\le \FSP $), rosso = estrapolazione}{figure.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Ricostruzione di dicembre~2025 (bootstrap dai dati di input EIOPA, LLFR a media pesata) vs curva EIOPA ufficiale, ai 15 tenor DLT e, per illustrare la convergenza in estrapolazione, ad alcuni tenor oltre l'FSP (30, 40, 50, 60 anni).}}{20}{table.3}\protected@file@percent }
\newlabel{tab:delta-dic}{{3}{20}{Ricostruzione di dicembre~2025 (bootstrap dai dati di input EIOPA, LLFR a media pesata) vs curva EIOPA ufficiale, ai 15 tenor DLT e, per illustrare la convergenza in estrapolazione, ad alcuni tenor oltre l'FSP (30, 40, 50, 60 anni)}{table.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Convergenza e sensitivit\`a.}{20}{table.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Distanza $\left \lvert f^c(t_F,t_F+h)-\mathrm  {UFR}^c \right \rvert $ in bps (scala logaritmica). Il forward estrapolato converge monotonicamente all'$\mathrm  {UFR}$, con velocit\`a governata dal peso $B(\alpha ,h)$.}}{21}{figure.10}\protected@file@percent }
\newlabel{fig:convufr}{{10}{21}{Distanza $\abs {f^c(t_F,t_F+h)-\UFR ^c}$ in bps (scala logaritmica). Il forward estrapolato converge monotonicamente all'$\UFR $, con velocit\`a governata dal peso $B(\alpha ,h)$}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Sensitivit\`a della velocit\`a di convergenza al parametro $\alpha $: distanza (in bps, scala log) dello spot dall'$\mathrm  {UFR}$ per tre valori di $\alpha $ (regime $11\%$, phasing-in $20\%$, SEK $40\%$). A parit\`a di scadenza un $\alpha $ maggiore riduce la distanza pi\`u rapidamente, ma lo scarto tra le tre curve resta qui di pochi bps: a dicembre~2025 l'$\mathrm  {LLFR}$ \`e gi\`a a soli $\sim \!2$ bps dall'$\mathrm  {UFR}$ (Sez.~\ref {sec:llfr-calcolo}), quindi c'\`e poco ``gap'' residuo da chiudere a velocit\`a diverse. L'effetto di $\alpha $ nella sua forma pura, indipendente dall'ampiezza del gap, \`e quello del peso $B(\alpha ,h)$ di Figura~\ref {fig:Bah}.}}{21}{figure.11}\protected@file@percent }
\newlabel{fig:sensalpha}{{11}{21}{Sensitivit\`a della velocit\`a di convergenza al parametro $\alpha $: distanza (in bps, scala log) dello spot dall'$\UFR $ per tre valori di $\alpha $ (regime $11\%$, phasing-in $20\%$, SEK $40\%$). A parit\`a di scadenza un $\alpha $ maggiore riduce la distanza pi\`u rapidamente, ma lo scarto tra le tre curve resta qui di pochi bps: a dicembre~2025 l'$\LLFR $ \`e gi\`a a soli $\sim \!2$ bps dall'$\UFR $ (Sez.~\ref {sec:llfr-calcolo}), quindi c'\`e poco ``gap'' residuo da chiudere a velocit\`a diverse. L'effetto di $\alpha $ nella sua forma pura, indipendente dall'ampiezza del gap, \`e quello del peso $B(\alpha ,h)$ di Figura~\ref {fig:Bah}}{figure.11}{}}
