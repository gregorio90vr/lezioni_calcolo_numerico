\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Curva spot EUR di dicembre~2025: nuovo metodo (bootstrap) vs Smith--Wilson, tenor $1$--$60$. Fino all'$\mathrm  {FSP}$ (20 anni, linea verticale) le due curve sono sovrapposte; oltre, si separano leggermente nell'avvicinarsi all'$\mathrm  {UFR}$ (linea punteggiata).}}{30}{figure.12}\protected@file@percent }
\newlabel{fig:sw-vs-new-curves}{{12}{30}{Curva spot EUR di dicembre~2025: nuovo metodo (bootstrap) vs Smith--Wilson, tenor $1$--$60$. Fino all'$\FSP $ (20 anni, linea verticale) le due curve sono sovrapposte; oltre, si separano leggermente nell'avvicinarsi all'$\UFR $ (linea punteggiata)}{figure.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Confronto metodologico a parit\`a di dati: curva spot EUR ufficiale di dicembre~2025 col nuovo metodo (bootstrap) e col metodo Smith--Wilson. Lo scarto isola l'effetto della \emph  {sola} metodologia. La riga in grassetto \`e l'$\mathrm  {FSP}$.}}{31}{table.8}\protected@file@percent }
\newlabel{tab:sw-vs-new-rivisto}{{8}{31}{Confronto metodologico a parit\`a di dati: curva spot EUR ufficiale di dicembre~2025 col nuovo metodo (bootstrap) e col metodo Smith--Wilson. Lo scarto isola l'effetto della \emph {sola} metodologia. La riga in grassetto \`e l'$\FSP $}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Scarto tra la curva spot EUR di dicembre~2025 costruita col nuovo metodo (bootstrap) e quella col metodo Smith--Wilson, in bps. Fino all'$\mathrm  {FSP}$ le due curve coincidono a frazioni di bp (interpolano gli stessi nodi liquidi); oltre l'$\mathrm  {FSP}$ (zona grigia) divergono, con un massimo attorno ai 38 anni (punto evidenziato).}}{31}{figure.13}\protected@file@percent }
\newlabel{fig:sw-vs-new}{{13}{31}{Scarto tra la curva spot EUR di dicembre~2025 costruita col nuovo metodo (bootstrap) e quella col metodo Smith--Wilson, in bps. Fino all'$\FSP $ le due curve coincidono a frazioni di bp (interpolano gli stessi nodi liquidi); oltre l'$\FSP $ (zona grigia) divergono, con un massimo attorno ai 38 anni (punto evidenziato)}{figure.13}{}}
